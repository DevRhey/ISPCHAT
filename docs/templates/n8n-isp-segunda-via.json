{
  "name": "ISP - 2a via boleto",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whaticket-segunda-via",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "const body = items[0].json.body || '';\nconst cpf = String(body).replace(/\\D/g, '');\nif (cpf.length < 11) {\n  return [{ json: { reply: 'Envie o CPF com 11 dígitos para gerar a 2ª via.' } }];\n}\n// TODO: chamar ERP (IXC/SGP) com o CPF\nreturn [{ json: {\n  messages: [\n    `Cliente CPF ${cpf} localizado.`,\n    'Segue o link da 2ª via: https://exemplo.com/boleto/' + cpf\n  ]\n}}];"
      },
      "name": "Processar CPF",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Processar CPF", "type": "main", "index": 0 }]]
    },
    "Processar CPF": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  }
}
